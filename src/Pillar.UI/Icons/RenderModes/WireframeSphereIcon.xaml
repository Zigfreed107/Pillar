<!--
    WireframeSphereIcon.xaml
    Defines the reusable wireframe-sphere icon for the wireframe viewport mode.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox x:Key="WireframeSphereIcon"
             x:Shared="False"
             Width="18"
             Height="18"
             Stretch="Uniform">
        <Grid>
            <Path Data="M0,50 
                  A50,50 0 1 1 100,50 
                  A50,50 0 1 1 0,50"
                  Fill="Transparent"  
                  Stroke="{DynamicResource 
                  Pillar.Brush.Accent}"
                  StrokeThickness="10" />
            
            <Path Data="M0,50 
                  A50,15 0 1 0 100,50"
                  Fill="Transparent"  
                  Stroke="{DynamicResource 
                  Pillar.Brush.Accent}"
                  StrokeThickness="10" />

            <Path Data="M50,0 
                  A15,50 0 1 0 50,100"
                  Fill="Transparent"  
                  Stroke="{DynamicResource 
                  Pillar.Brush.Accent}"
                  StrokeThickness="10" />
        </Grid>
    </Viewbox>

</ResourceDictionary>
