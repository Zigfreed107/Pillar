<!--
    ShadedSphereIcon.xaml
    Defines the reusable faceted shaded-sphere icon for the shaded viewport mode.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox x:Key="ShadedSphereIcon"
             x:Shared="False"
             Width="18"
             Height="18"
             Stretch="Uniform">
        <Grid>
            <Path Data="M0,50 
                  A50,50 0 1 1 100,50 
                  A50,50 0 1 1 0,50"
                  Fill="{DynamicResource Pillar.Brush.AccentDark}"/>
            <Path Data="M20,20 
                  A20,20 0 1 1 60,20 
                  A20,20 0 1 1 20,20"
                  Fill="{DynamicResource Pillar.Brush.Accent}"/>
            <Path Data="M0,50 
                  A50,50 0 1 1 100,50 
                  A50,50 0 1 1 0,50"
                  Fill="Transparent"  
                  Stroke="{DynamicResource Pillar.Brush.Accent}"
                  StrokeThickness="10" />
        </Grid>
    </Viewbox>

</ResourceDictionary>
