<!--
    ShadedSphereIcon.xaml
    Defines the reusable faceted shaded-sphere icon for the shaded viewport mode.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox x:Key="SelectByClickIcon"
             x:Shared="False"
             Stretch="Uniform" Margin="2">
        <Grid Width="104" Height="104" >
            <Path Data="M50,40 L100,80 L70,80 L50,100 Z" 
                  Stroke="{DynamicResource Pillar.Brush.AccentDark}"
                  StrokeThickness="7" StrokeLineJoin="Round"
                  />
            <Path Data="M30,40 L10,40 M35,25 L20,5 M50,20 L50,0"
                  Stroke="{DynamicResource Pillar.Brush.Accent}"
                  StrokeThickness="10" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  />
        </Grid>
    </Viewbox>

</ResourceDictionary>
