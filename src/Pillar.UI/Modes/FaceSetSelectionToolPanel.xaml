<!--
    FaceSetSelectionToolPanel.xaml
    Provides the floating controls for temporary mesh-face selection sessions launched by client tools.
-->
<UserControl x:Class="Pillar.UI.Modes.FaceSetSelectionToolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Pillar.UI.Controls"
             MinWidth="360"
             IsHitTestVisible="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="FaceSelectionPanelBackgroundBrush"
                         Color="{DynamicResource Pillar.Color.BackgroundTransparent}" />
        <SolidColorBrush x:Key="FaceSelectionPanelBorderBrush"
                         Color="{DynamicResource Pillar.Color.Border}" />
    </UserControl.Resources>

    <Border Style="{StaticResource ViewportOverlayPanelStyle}"
            Background="{DynamicResource FaceSelectionPanelBackgroundBrush}"
            BorderBrush="{DynamicResource FaceSelectionPanelBorderBrush}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left"
                           Style="{DynamicResource OverlayPanelTitleTextStyle}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontFamily="Segoe Fluent Icons"
                           Text="&#xE879;" />
                <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0"
                           Style="{DynamicResource OverlayPanelTitleTextStyle}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Face Selection" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ViewportOverlayPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Selection By:" Grid.Row="0" Style="{DynamicResource OverlayPanelContentStyle}"/>
                        <StackPanel Grid.Row="1" Margin="0,6,0,0"
                                    Orientation="Horizontal">
                            <ToggleButton x:Name="SelectToolButton"
                                          Style="{DynamicResource PillarToggleButtonStyle}"
                                          Width="34"
                                          Height="28"
                                          Padding="2"
                                          Margin="0,0,4,0"
                                          Content="{StaticResource SelectByClickIcon}"
                                          Click="SelectToolButton_Click"
                                          ToolTip="Click on individual faces to select them."/>
                            <ToggleButton x:Name="LineSelectToolButton"
                                          Style="{DynamicResource PillarToggleButtonStyle}"
                                          Width="34"
                                          Height="28"
                                          Padding="2"
                                          Margin="0,0,4,0"
                                          Content="{StaticResource SelectByLineIcon}"
                                          Click="LineSelectToolButton_Click"
                                          ToolTip="Draw a line and select faces it crosses."/>
                            <ToggleButton x:Name="PolygonSelectToolButton"
                                          Style="{DynamicResource PillarToggleButtonStyle}"
                                          Width="34"
                                          Height="28"
                                          Padding="2"
                                          Content="{StaticResource SelectByPolygonIcon}"
                                          Click="PolygonSelectToolButton_Click"
                                          ToolTip="Draw a polygon and select any faces inside."/>
                        </StackPanel>
                        <TextBlock Text="Selection Mode:" Margin="0,12,0,0" Grid.Row="2" Style="{DynamicResource OverlayPanelContentStyle}" />

                        <StackPanel Grid.Row="3" Margin="0,6,0,0" Orientation="Horizontal">
                            <ToggleButton x:Name="AddModifierButton"
                                            Style="{DynamicResource PillarToggleButtonStyle}"
                                            Width="34"
                                            Height="28"
                                            Padding="2"
                                            Margin="0,0,4,0"
                                            Content="{StaticResource AdditionSelectionIcon}"
                                            Click="AddModifierButton_Click"
                                            ToolTip="Add to the current selection."/>
                            <ToggleButton x:Name="RemoveModifierButton"
                                            Style="{DynamicResource PillarToggleButtonStyle}"
                                            Width="34"
                                            Height="28"
                                            Padding="2"
                                            Content="{StaticResource SubtractionSelectionIcon}"
                                            Click="RemoveModifierButton_Click"
                                            ToolTip="Subtract from the current selection."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ViewportOverlayPanelStyle}" Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="AngleSelectCheckBox"
                                  Grid.Row="0"
                                  Style="{DynamicResource PillarCheckBoxStyle}"
                                  VerticalAlignment="Center"
                                  Content="Angle Select"
                                  ToolTip="Select coplanar neigbouring faces."
                                  Click="AngleSelectToggleButton_Click" />
                        <TextBlock Grid.Row="1"
                                   Margin="12,12,0,0" HorizontalAlignment="Right" Style="{DynamicResource OverlayPanelContentStyle}"
                                   VerticalAlignment="Center"
                                   Text="Coplanar threshold:" />
                        <controls:NumericUpDown x:Name="CoplanarThresholdNumericUpDown"
                                                Grid.Row="2" Width="42"
                                                Margin="12,6,0,0"
                                                HorizontalAlignment="Right"
                                                IsEnabled="{Binding IsChecked, ElementName=AngleSelectCheckBox}"
                                                UnitText="&#x00B0;"
                                                Minimum="0"
                                                Maximum="180"
                                                Increment="1"
                                                DecimalPlaces="0"
                                                ToolTip="Faces that are coplanar by less than this angle will be selected."
                                                Value="15"
                                                ValueChanged="CoplanarThresholdNumericUpDown_ValueChanged" />
                    </Grid>

                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="UndoFaceSelectionButton"
                        MinWidth="34" Style="{DynamicResource PillarButtonStyle}"
                        FontFamily="Segoe Fluent Icons" FontWeight="Bold"
                        Margin="0,0,4,0"
                        Padding="8,3"
                        ToolTip="Undo selection."
                        Content="&#xE7A7;" 
                        Click="UndoButton_Click" />
                <Button x:Name="RedoFaceSelectionButton"
                        MinWidth="34" Style="{DynamicResource PillarButtonStyle}"
                        FontFamily="Segoe Fluent Icons"  FontWeight="Bold"
                        Padding="8,3"
                        ToolTip="Redo selection."
                        Margin="0,0,4,0"
                        Content="&#xE7A6;"
                        Click="RedoButton_Click" />
                <Button MinWidth="34" Style="{DynamicResource PillarButtonStyle}"
                        Margin="0,0,4,0"
                        FontFamily="Segoe Fluent Icons" FontWeight="Bold"
                        Padding="8,3"
                        ToolTip="Deselect all faces."
                        Content="&#xED62;" 
                        Click="ClearButton_Click" />
                <Button DockPanel.Dock="Right" Style="{DynamicResource PillarButtonStyle}"
                        Width="56"
                        Padding="10,3"
                        ToolTip="Accept selection and continue."
                        Content="Apply"
                        Click="OkButton_Click" />
            </StackPanel>

            <TextBlock x:Name="ToolPromptTextBlock"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource Pillar.Brush.TextMuted}"
                       Text="Click on a face"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
