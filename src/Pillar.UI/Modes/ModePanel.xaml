<!--
    ModePanel.xaml
    Defines the always-visible ribbon-style workflow panel that sits beside the layer panel and previews high-level mode and tool organization.
-->
<UserControl x:Class="Pillar.UI.Modes.ModePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             MinWidth="340">
    <UserControl.Resources>
        <!-- Border chrome for this viewport overlay. -->
        <Style x:Key="ViewportOverlayPanelStyle" TargetType="Border">
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Pillar.Brush.Background2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pillar.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Pillar.CornerRadius.Panel}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <SolidColorBrush x:Key="ModePanelBackgroundBrush"
                         Color="{DynamicResource Pillar.Color.BackgroundTransparent}" />
        <SolidColorBrush x:Key="ModePanelBorderBrush"
                         Color="{DynamicResource Pillar.Color.Border}" />
        <SolidColorBrush x:Key="ModePanelTabPanelBackgroundBrush"
                         Color="{DynamicResource Pillar.Color.BackgroundTransparent}" />
        <SolidColorBrush x:Key="ModePanelTabPanelBorderBrush"
                         Color="{DynamicResource Pillar.Color.Border}" />
        <SolidColorBrush x:Key="ModePanelTabBackgroundBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ModePanelTabHoverBackgroundBrush"
                         Color="{DynamicResource Pillar.Color.Element1}" />
        <SolidColorBrush x:Key="ModePanelTabSelectedBackgroundBrush"
                         Color="{DynamicResource Pillar.Color.AccentSubtleTransparent}" />
        <SolidColorBrush x:Key="ModePanelTabBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ModePanelTabSelectedBorderBrush"
                         Color="{DynamicResource Pillar.Color.Accent}" />
        <SolidColorBrush x:Key="ModePanelTabForegroundBrush"
                         Color="{DynamicResource Pillar.Color.TextSecondary}" />
        <SolidColorBrush x:Key="ModePanelTabSelectedForegroundBrush"
                         Color="{DynamicResource Pillar.Color.TextPrimary}" />

        <Style x:Key="ModePanelToolTitleTextStyle"
               BasedOn="{StaticResource PillarToolTitleTextStyle}"
               TargetType="TextBlock" />

        <Style x:Key="ModePanelToolDescriptionTextStyle"
               BasedOn="{StaticResource PillarToolDescriptionTextStyle}"
               TargetType="TextBlock" />

        <Style x:Key="ModePanelImportPromptStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasImportedModels}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModePanelSelectionPromptStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasImportedModels}" Value="True" />
                        <Condition Binding="{Binding CanShowWorkflowTabs}" Value="False" />
                        <Condition Binding="{Binding HasSelectedModelLayer}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModePanelTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background"
                    Value="{DynamicResource ModePanelTabBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ModePanelTabBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground"
                    Value="{DynamicResource ModePanelTabForegroundBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Own the tab chrome so Fluent cannot replace Pillar's selected-state colours. -->
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4,4,0,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ModePanelTabHoverBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Panel.ZIndex" Value="1" />
                    <Setter Property="Background"
                            Value="{DynamicResource ModePanelTabSelectedBackgroundBrush}" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource ModePanelTabSelectedBorderBrush}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource ModePanelTabSelectedForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModePanelTabsStyle" TargetType="TabControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background"
                    Value="{DynamicResource ModePanelTabPanelBackgroundBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ModePanelTabPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource ModePanelTabItemStyle}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasImportedModels}" Value="True" />
                        <Condition Binding="{Binding CanShowWorkflowTabs}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModePanelSupportToolsStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMultipleSelectedModels}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModePanelSupportMultiSelectionPromptStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMultipleSelectedModels}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModePanelEditSupportToolsContainerStyle" TargetType="StackPanel">
            <Setter Property="IsEnabled" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanUseSupportEditingTools}" Value="True">
                    <Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModePanelEditSupportSelectionPromptStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Foreground" Value="{DynamicResource Pillar.Brush.Warning}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanUseSupportEditingTools}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource ViewportOverlayPanelStyle}"
            Background="{DynamicResource ModePanelBackgroundBrush}"
            BorderBrush="{DynamicResource ModePanelBorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ModePanelImportPromptStyle}">
                <Grid>
                    <TextBlock Style="{StaticResource OverlayPanelTitleIconStyle}"
                           Text="&#xF167;" FontSize="20" FontWeight="Normal" Foreground="{DynamicResource Pillar.Brush.Z}" />
                    <TextBlock Style="{StaticResource OverlayPanelTitleIconStyle}"
                           FontSize="20" FontWeight="Normal"
                           Text="&#xE946;" />
                </Grid>
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource OverlayPanelContentStyle}">
                    <Run Text="Import a model via the "/>
                    <Run Text="File " Foreground="{DynamicResource Pillar.Brush.Warning}"/>
                    <Run Text="menu or the "/>
                    <Run Text="Layers Panel" Foreground="{DynamicResource Pillar.Brush.Warning}"/>
                    <Run Text="."/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ModePanelSelectionPromptStyle}">
                <Grid>
                    <TextBlock Style="{StaticResource OverlayPanelTitleIconStyle}"
                           Text="&#xF167;" FontSize="20" FontWeight="Normal" Foreground="{DynamicResource Pillar.Brush.Z}" />
                    <TextBlock Style="{StaticResource OverlayPanelTitleIconStyle}"
                           FontSize="20" FontWeight="Normal"
                           Text="&#xE946;" />
                </Grid>
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource OverlayPanelContentStyle}"
                           Text="Select a model in the Viewer or Layers panel to edit it or add supports." />
            </StackPanel>

            <TabControl Grid.Row="0"
                        Style="{StaticResource ModePanelTabsStyle}">
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Style="{StaticResource OverlayPanelSubheadingTextStyle}"
                                   Text="Transform" />
                    </TabItem.Header>

                    <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">

                        <primitives:UniformGrid Margin="0,0,0,0" Columns="3">
                            <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                    Click="TranslateButton_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}"
                                               Text="Translate" />
                                    <TextBlock Style="{StaticResource ModePanelToolDescriptionTextStyle}"
                                               Text="Move the active model in space" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                    Click="RotateButton_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}"
                                               Text="Rotate" />
                                    <TextBlock Style="{StaticResource ModePanelToolDescriptionTextStyle}"
                                               Text="Adjust orientation to reduce overhangs" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                    Click="ScaleButton_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}"
                                               Text="Scale" />
                                    <TextBlock Style="{StaticResource ModePanelToolDescriptionTextStyle}"
                                               Text="Resize the imported model uniformly" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                    Click="MoveToPlateButton_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}"
                                               Text="Move to Plate" />
                                    <TextBlock Style="{StaticResource ModePanelToolDescriptionTextStyle}"
                                               Text="Place the lowest model vertex at Z 0" />
                                </StackPanel>
                            </Button>
                        </primitives:UniformGrid>
                    </StackPanel>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Style="{StaticResource OverlayPanelSubheadingTextStyle}"
                                   Text="Supports" />
                    </TabItem.Header>

                    <Grid Margin="0,12,0,0">
                        <StackPanel Style="{StaticResource ModePanelSupportToolsStyle}">
                            <TextBlock Style="{StaticResource ModeOverlayLabelTextStyle}"
                                       Text="Support Creation" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource ModeOverlayBodyTextStyle}"
                                       Text="These buttons preview how manual support operations will live inside the ribbon-style workflow panel." />

                            <primitives:UniformGrid Margin="0,10,0,0"
                                                    Columns="3">
                                <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                        Click="PointSupportButton_Click">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}"
                                                   Text="Point" />
                                        <TextBlock Style="{StaticResource ModePanelToolDescriptionTextStyle}"
                                                   Text="Place a single support at a picked point" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                        Click="LineSupportButton_Click">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}"
                                                   Text="Line" />
                                        <TextBlock Style="{StaticResource ModePanelToolDescriptionTextStyle}"
                                                   Text="Create a row of supports between two picks" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                        Click="RingSupportButton_Click">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}"
                                                   Text="Ring" />
                                        <TextBlock Style="{StaticResource ModePanelToolDescriptionTextStyle}"
                                                   Text="Distribute supports around a circular region" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                        Click="ContourSupportButton_Click">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}"
                                                   Text="Contour" />
                                        <TextBlock Style="{StaticResource ModePanelToolDescriptionTextStyle}"
                                                   Text="Trace a connected face contour at a Z height" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                        Click="AreaSupportButton_Click">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}"
                                                   Text="Area Support" />
                                        <TextBlock Style="{StaticResource ModePanelToolDescriptionTextStyle}"
                                                   Text="Fill selected face areas with supports" />
                                    </StackPanel>
                                </Button>

                            </primitives:UniformGrid>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center"
                                    Style="{StaticResource ModePanelSupportMultiSelectionPromptStyle}">
                            <TextBlock Style="{StaticResource ModeOverlayLabelTextStyle}"
                                       Text="Support Creation" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource ModeOverlayBodyTextStyle}"
                                       Text="Select one model only before adding supports." />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Style="{StaticResource OverlayPanelSubheadingTextStyle}"
                                   Text="Edit Supports" />
                    </TabItem.Header>

                    <Grid Margin="0,12,0,0">
                        <StackPanel Style="{StaticResource ModePanelEditSupportToolsContainerStyle}">
                            <TextBlock Style="{StaticResource ModeOverlayLabelTextStyle}"
                                       Text="Support Editing" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource ModePanelEditSupportSelectionPromptStyle}"
                                       Text="You must one support layer to use these tools." />

                            <primitives:UniformGrid Margin="0,10,0,0"
                                                    Columns="3">
                                <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                        Click="ClusterSupportButton_Click">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}"
                                                   Text="Cluster" />
                                        <TextBlock Style="{StaticResource ModePanelToolDescriptionTextStyle}"
                                                   Text="Replace nearby supports with shared stems" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                        Click="BraceSupportButton_Click">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}"
                                                   Text="Brace" />
                                        <TextBlock Style="{StaticResource ModePanelToolDescriptionTextStyle}"
                                                   Text="Add braces and buttresses" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                        Click="DirectEditSupportButton_Click">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}"
                                                   Text="Direct Edit" />
                                        <TextBlock Style="{StaticResource ModePanelToolDescriptionTextStyle}"
                                                   Text="Move support stems with viewport handles" />
                                    </StackPanel>
                                </Button>
                            </primitives:UniformGrid>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Style="{StaticResource OverlayPanelSubheadingTextStyle}"
                                   Text="Rafts" />
                    </TabItem.Header>
                    <StackPanel Margin="0,12,0,0">
                        <primitives:UniformGrid Columns="3">
                            <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                    IsEnabled="{Binding CanGenerateRaft}"
                                    Click="RaftButton_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}" Text="Add Raft" />
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource ModePanelToolDescriptionTextStyle}"
                                                   TargetType="TextBlock">
                                                <Setter Property="Text"
                                                        Value="Select a model with at least one support." />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanGenerateRaft}" Value="True">
                                                        <Setter Property="Text"
                                                                Value="Generate a build-plate raft for the active model." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                    IsEnabled="{Binding CanAddTag}"
                                    Click="TagButton_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}" Text="Add Tag" />
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource ModePanelToolDescriptionTextStyle}"
                                                   TargetType="TextBlock">
                                                <Setter Property="Text"
                                                        Value="Select a model with a raft." />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanAddTag}" Value="True">
                                                        <Setter Property="Text"
                                                                Value="Add a tag to a raft." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PillarModePanelToolButtonStyle}"
                                    IsEnabled="{Binding CanAddRaftText}"
                                    Click="RaftTextButton_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ModePanelToolTitleTextStyle}" Text="Raft Text" />
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource ModePanelToolDescriptionTextStyle}"
                                                   TargetType="TextBlock">
                                                <Setter Property="Text"
                                                        Value="Select a model with a raft." />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanAddRaftText}" Value="True">
                                                        <Setter Property="Text"
                                                                Value="Add a text to a raft." />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </primitives:UniformGrid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
