<!--
    ToolSessionOptionsControl.xaml
    Provides a reusable minimal options panel for active tool sessions that do not yet need dedicated controls.
-->
<UserControl x:Class="Pillar.UI.Modes.ToolSessionOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:modes="clr-namespace:Pillar.UI.Modes">
    <UserControl.Resources>
        <!-- Border chrome for this viewport overlay. -->
        <Style x:Key="ViewportOverlayPanelStyle" TargetType="Border">
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Pillar.Brush.Background2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pillar.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Pillar.CornerRadius.Panel}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <SolidColorBrush x:Key="ToolOptionsPanelBackgroundBrush"
                         Color="{DynamicResource Pillar.Color.BackgroundTransparent}" />
        <SolidColorBrush x:Key="ToolOptionsPanelBorderBrush"
                         Color="{DynamicResource Pillar.Color.Border}" />
    </UserControl.Resources>

    <Border Style="{StaticResource ViewportOverlayPanelStyle}"
            Background="{DynamicResource ToolOptionsPanelBackgroundBrush}"
            BorderBrush="{DynamicResource ToolOptionsPanelBorderBrush}">
        <StackPanel>
            <TextBlock x:Name="SessionTitleTextBlock"
                       Style="{StaticResource OverlayPanelTitleTextStyle}"
                       Text="Tool Options" />

            <TextBlock x:Name="SessionDescriptionTextBlock"
                       Margin="0,10,0,0"
                       Style="{StaticResource ModeOverlayBodyTextStyle}"
                       TextWrapping="Wrap"
                       Text="This tool is active." />

            <modes:SupportBaseGenerationOptionsControl x:Name="SupportBaseGenerationOptions"
                                                       Margin="0,14,0,0"
                                                       Visibility="Collapsed" />

            <Button Margin="0,16,0,0"
                    MinHeight="30"
                    HorizontalAlignment="Stretch"
                    Click="FinishButton_Click"
                    Content="Finish" />
        </StackPanel>
    </Border>
</UserControl>
