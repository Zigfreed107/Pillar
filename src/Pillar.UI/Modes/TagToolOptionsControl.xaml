<!--
    TagToolOptionsControl.xaml
    Presents editable raft-tag settings and switches to placement guidance while the pointer controls location.
-->
<UserControl x:Class="Pillar.UI.Modes.TagToolOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Pillar.UI.Controls"
             MinWidth="290">
    <Border Style="{StaticResource ViewportOverlayPanelStyle}">
        <Grid>
            <StackPanel x:Name="OptionsPanel">
                <TextBlock Style="{StaticResource ModeOverlayTitleTextStyle}" Text="Tag" />

                <TextBlock Margin="0,10,0,0" Style="{StaticResource ModeOverlayLabelTextStyle}" Text="Tag Height (mm)" />
                <controls:NumericUpDown x:Name="TagHeightInput" Margin="0,4,0,0" Minimum="0.01" Maximum="100" Increment="0.1" Value="0.7" ValueChanged="AnyOption_Changed" />

                <TextBlock Margin="0,8,0,0" Style="{StaticResource ModeOverlayLabelTextStyle}" Text="Edge Angle (degrees)" />
                <controls:NumericUpDown x:Name="EdgeAngleInput" Margin="0,4,0,0" Minimum="30" Maximum="90" Increment="1" DecimalPlaces="0" Value="45" ValueChanged="AnyOption_Changed" />

                <TextBlock Margin="0,8,0,0" Style="{StaticResource ModeOverlayLabelTextStyle}" Text="Border Offset (mm)" />
                <controls:NumericUpDown x:Name="BorderOffsetInput" Margin="0,4,0,0" Minimum="0" Maximum="100" Increment="0.1" Value="1" ValueChanged="AnyOption_Changed" />

                <TextBlock Margin="0,8,0,0" Style="{StaticResource ModeOverlayLabelTextStyle}" Text="Outer Width (mm)" />
                <controls:NumericUpDown x:Name="OuterWidthInput" Margin="0,4,0,0" Minimum="0" Maximum="1000" Increment="0.5" Value="8.5" ValueChanged="AnyOption_Changed" />

                <TextBlock Margin="0,8,0,0" Style="{StaticResource ModeOverlayLabelTextStyle}" Text="Inner Width (mm)" />
                <controls:NumericUpDown x:Name="InnerWidthInput" Margin="0,4,0,0" Minimum="0" Maximum="1000" Increment="0.5" Value="8.5" ValueChanged="AnyOption_Changed" />

                <TextBlock Margin="0,8,0,0" Style="{StaticResource ModeOverlayLabelTextStyle}" Text="Text" />
                <TextBox x:Name="TagTextBox" Margin="0,4,0,0" TextChanged="AnyTextOption_Changed" />

                <TextBlock Margin="0,8,0,0" Style="{StaticResource ModeOverlayLabelTextStyle}" Text="Font" />
                <ComboBox x:Name="FontComboBox"
                          Margin="0,4,0,0"
                          IsTextSearchEnabled="True"
                          SelectionChanged="AnySelectionOption_Changed" />

                <TextBlock Margin="0,8,0,0" Style="{StaticResource ModeOverlayLabelTextStyle}" Text="Font Size (mm)" />
                <controls:NumericUpDown x:Name="FontSizeInput" Margin="0,4,0,0" Minimum="0.01" Maximum="100" Increment="0.5" Value="5" ValueChanged="AnyOption_Changed" />

                <TextBlock Margin="0,8,0,0" Style="{StaticResource ModeOverlayLabelTextStyle}" Text="Text Height (mm)" />
                <controls:NumericUpDown x:Name="TextHeightInput" Margin="0,4,0,0" Minimum="0.1" Maximum="100" Increment="0.1" Value="1" ValueChanged="AnyOption_Changed" />

                <ToggleButton x:Name="FlipTextButton"
                              Margin="0,12,0,0"
                              Content="Flip"
                              ToolTip="Rotate the text 180 degrees."
                              Checked="FlipTextButton_Changed"
                              Unchecked="FlipTextButton_Changed" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Place" Click="PlaceButton_Click" />
                    <Button Grid.Column="2" Content="Close" Click="CloseButton_Click" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="PlacementInstructionsPanel"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Style="{StaticResource ModeOverlayTitleTextStyle}" Text="Place Tag" />
                <TextBlock Margin="0,10,0,0"
                           Style="{StaticResource ModeOverlayBodyTextStyle}"
                           Text="Move the mouse in the viewer to choose the tag's location. Click to place the tag." />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
