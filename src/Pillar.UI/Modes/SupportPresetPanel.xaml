<!--
    SupportPresetPanel.xaml
    Provides the compact viewport overlay used by support tools to choose the active support preset.
-->
<UserControl x:Class="Pillar.UI.Modes.SupportPresetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="240">
    <UserControl.Resources>
        <!-- Border chrome for this viewport overlay. -->
        <Style x:Key="ViewportOverlayPanelStyle" TargetType="Border">
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Pillar.Brush.Background2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Pillar.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Pillar.CornerRadius.Panel}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <SolidColorBrush x:Key="SupportPresetPanelBackgroundBrush"
                         Color="{DynamicResource Pillar.Color.BackgroundTransparent}" />
        <SolidColorBrush x:Key="SupportPresetPanelBorderBrush"
                         Color="{DynamicResource Pillar.Color.Border}" />
    </UserControl.Resources>

    <Border Style="{StaticResource ViewportOverlayPanelStyle}"
            Background="{DynamicResource SupportPresetPanelBackgroundBrush}"
            BorderBrush="{DynamicResource SupportPresetPanelBorderBrush}">
        <StackPanel>
            <TextBlock Style="{StaticResource OverlayPanelTitleTextStyle}"
                       Text="Support Preset" />

            <ComboBox x:Name="PresetComboBox"
                      Margin="0,10,0,0"
                      DisplayMemberPath="Name"
                      SelectionChanged="PresetComboBox_SelectionChanged" />

            <Border Height="112"
                    Margin="0,12,0,0"
                    BorderBrush="{DynamicResource Pillar.Brush.Border}"
                    BorderThickness="1"
                    Background="{DynamicResource Pillar.Brush.Element1}" />

            <Button Margin="0,12,0,0"
                    Padding="10,4"
                    HorizontalAlignment="Right"
                    Content="Advanced"
                    Click="AdvancedButton_Click" />
        </StackPanel>
    </Border>
</UserControl>
