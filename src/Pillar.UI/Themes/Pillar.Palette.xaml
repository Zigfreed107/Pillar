    <Color x:Key="Pillar.Color.Control.Accent.Border.Enabled">#FFD80019</Color>
    <Color x:Key="Pillar.Color.Control.Accent.Border.Pressed">#FFD80019</Color>
    
    <Color x:Key="Pillar.Color.Control.Subtle.BG.Default">#FF0D1218</Color>
    <Color x:Key="Pillar.Color.Control.Subtle.BG.Hover">#FF0D1218</Color>
    <Color x:Key="Pillar.Color.Control.Subtle.BG.Enabled">#FF3B4044</Color>
    <Color x:Key="Pillar.Color.Control.Subtle.BG.Pressed">#FF4A4E52</Color>
    <Color x:Key="Pillar.Color.Control.Subtle.Border.Default">#FF0D1218</Color>
    <Color x:Key="Pillar.Color.Control.Subtle.Border.Hover">#FF3B4044</Color>
    <Color x:Key="Pillar.Color.Control.Subtle.Border.Enabled">#FF3B4044</Color>
    <Color x:Key="Pillar.Color.Control.Subtle.Border.Pressed">#FF3B4044</Color>
    
    <Color x:Key="Pillar.Color.Control.Opaque.BG.Default">#FF0D1218</Color>
    <Color x:Key="Pillar.Color.Control.Opaque.BG.Hover">#FF0D1218</Color>
    <Color x:Key="Pillar.Color.Control.Opaque.BG.Enabled">#FF1E4446</Color>
    <Color x:Key="Pillar.Color.Control.Opaque.BG.Pressed">#FF486769</Color>
    <Color x:Key="Pillar.Color.Control.Opaque.Border.Default">#5558D8C9</Color>
    <Color x:Key="Pillar.Color.Control.Opaque.Border.Hover">#FF58D8C9</Color>
    <Color x:Key="Pillar.Color.Control.Opaque.Border.Enabled">#FF58D8C9</Color>
    <Color x:Key="Pillar.Color.Control.Opaque.Border.Pressed">#FF58D8C9</Color>

    <Color x:Key="Pillar.Color.Text.Default">#FFB5C1CB</Color>
    <Color x:Key="Pillar.Color.Text.Accent">#FF58D8C9</Color>
    <Color x:Key="Pillar.Color.Text.Subtle">#FF81909D</Color>
    <Color x:Key="Pillar.Color.Text.Title">#FFF2F6F8</Color>
    <Color x:Key="Pillar.Color.Text.Subtitle">#FFB5C1CB</Color>
    <Color x:Key="Pillar.Color.Text.Disabled">#28B5C1CB</Color>

    
    
    
    


    <!--Main UI Elements-->
    <SolidColorBrush x:Key="Pillar.Brush.DEBUG" Color="{DynamicResource Pillar.Color.DEBUG}" />

    <SolidColorBrush x:Key="Pillar.Brush.Framing.Opaque.BG.Default" Color="{DynamicResource Pillar.Color.Framing.Opaque.BG.Default}" />
    <SolidColorBrush x:Key="Pillar.Brush.Framing.Opaque.Border.Default" Color="{DynamicResource Pillar.Color.Framing.Opaque.Border.Default}" />

    <SolidColorBrush x:Key="Pillar.Brush.Framing.Standard.BG.Default" Color="{DynamicResource Pillar.Color.Framing.Standard.BG.Default}" />
    <SolidColorBrush x:Key="Pillar.Brush.Framing.Standard.Border.Default" Color="{DynamicResource Pillar.Color.Framing.Standard.Border.Default}" />

    <SolidColorBrush x:Key="Pillar.Brush.Framing.Accent.BG.Default" Color="{DynamicResource Pillar.Color.Framing.Accent.BG.Default}" />
    <SolidColorBrush x:Key="Pillar.Brush.Framing.Accent.Border.Default" Color="{DynamicResource Pillar.Color.Framing.Accent.Border.Default}" />

    <SolidColorBrush x:Key="Pillar.Brush.Framing.Subtle.BG.Default" Color="{DynamicResource Pillar.Color.Framing.Subtle.BG.Default}" />
    <SolidColorBrush x:Key="Pillar.Brush.Framing.Subtle.Border.Default" Color="{DynamicResource Pillar.Color.Framing.Subtle.Border.Default}" />

    <SolidColorBrush x:Key="Pillar.Brush.BG.3DViewport" Color="{DynamicResource Pillar.Color.BG.3DViewport}" />
    <SolidColorBrush x:Key="Pillar.Brush.Border.3DViewport" Color="{DynamicResource Pillar.Color.Border.3DViewport}" />

    <SolidColorBrush x:Key="Pillar.Brush.Control.Standard.BG.Default" Color="{DynamicResource Pillar.Color.Control.Standard.BG.Default}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Standard.BG.Hover" Color="{DynamicResource Pillar.Color.Control.Standard.BG.Hover}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Standard.BG.Enabled" Color="{DynamicResource Pillar.Color.Control.Standard.BG.Enabled}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Standard.BG.Pressed" Color="{DynamicResource Pillar.Color.Control.Standard.BG.Pressed}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Standard.Border.Default" Color="{DynamicResource Pillar.Color.Control.Standard.Border.Default}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Standard.Border.Hover" Color="{DynamicResource Pillar.Color.Control.Standard.Border.Hover}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Standard.Border.Enabled" Color="{DynamicResource Pillar.Color.Control.Standard.Border.Enabled}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Standard.Border.Pressed" Color="{DynamicResource Pillar.Color.Control.Standard.Border.Pressed}" />

    <SolidColorBrush x:Key="Pillar.Brush.Control.Accent.BG.Default" Color="{DynamicResource Pillar.Color.Control.Accent.BG.Default}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Accent.BG.Hover" Color="{DynamicResource Pillar.Color.Control.Accent.BG.Hover}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Accent.BG.Enabled" Color="{DynamicResource Pillar.Color.Control.Accent.BG.Enabled}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Accent.BG.Pressed" Color="{DynamicResource Pillar.Color.Control.Accent.BG.Pressed}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Accent.Border.Default" Color="{DynamicResource Pillar.Color.Control.Accent.Border.Default}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Accent.Border.Hover" Color="{DynamicResource Pillar.Color.Control.Accent.Border.Hover}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Accent.Border.Enabled" Color="{DynamicResource Pillar.Color.Control.Accent.Border.Enabled}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Accent.Border.Pressed" Color="{DynamicResource Pillar.Color.Control.Accent.Border.Pressed}" />

    <SolidColorBrush x:Key="Pillar.Brush.Control.Subtle.BG.Default" Color="{DynamicResource Pillar.Color.Control.Subtle.BG.Default}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Subtle.BG.Hover" Color="{DynamicResource Pillar.Color.Control.Subtle.BG.Hover}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Subtle.BG.Enabled" Color="{DynamicResource Pillar.Color.Control.Subtle.BG.Enabled}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Subtle.BG.Pressed" Color="{DynamicResource Pillar.Color.Control.Subtle.BG.Pressed}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Subtle.Border.Default" Color="{DynamicResource Pillar.Color.Control.Subtle.Border.Default}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Subtle.Border.Hover" Color="{DynamicResource Pillar.Color.Control.Subtle.Border.Hover}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Subtle.Border.Enabled" Color="{DynamicResource Pillar.Color.Control.Subtle.Border.Enabled}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Subtle.Border.Pressed" Color="{DynamicResource Pillar.Color.Control.Subtle.Border.Pressed}" />

    <SolidColorBrush x:Key="Pillar.Brush.Control.Opaque.BG.Default" Color="{DynamicResource Pillar.Color.Control.Opaque.BG.Default}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Opaque.BG.Hover" Color="{DynamicResource Pillar.Color.Control.Opaque.BG.Hover}" />
    <SolidColorBrush x:Key="Pillar.Brush.Control.Opaque.BG.Enabled" Color="{DynamicResource Pillar.Color.Control.Opaque.BG.Enabled}" />
