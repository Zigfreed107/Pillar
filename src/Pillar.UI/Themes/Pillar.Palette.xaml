<!--
    Pillar.Palette.xaml
    Defines application-wide color tokens and semantic brushes for Pillar's dark CAD interface.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Pillar.Color.DEBUG">Magenta</Color>
    <!--Status Bar, Toolbar-->


    <Color x:Key="Pillar.Color.Framing.Opaque.BG.Default">#F21A232D</Color> <!--Status Bar, Toolbar-->
    <Color x:Key="Pillar.Color.Framing.Opaque.Border.Default">#FF3A4A59</Color>
    
    <Color x:Key="Pillar.Color.Framing.Standard.BG.Default">#F2181f27</Color> <!--Panels-->
