<!--
    Pillar.TextBlock.xaml
    Defines reusable TextBlock styles for warnings and tool-launch content.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PillarWarningTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Pillar.Brush.Warning}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PillarToolTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Pillar.FontSize.Subheading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Pillar.Brush.TextPrimary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PillarToolDescriptionTextStyle"
           BasedOn="{StaticResource PillarMutedTextStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
