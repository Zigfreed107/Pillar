<!--
    Pillar.Border.xaml
    Defines reusable Border styles for application chrome, panels, and viewport surfaces.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PillarTopChromeStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Background" Value="{DynamicResource Pillar.Brush.Background2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Pillar.Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PillarDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="{DynamicResource Pillar.Brush.Border}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PillarPopupSurfaceStyle" TargetType="Border">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{DynamicResource Pillar.Brush.Element1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Pillar.Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Pillar.CornerRadius.Control}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PillarViewportFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Pillar.Brush.3DViewportBG}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Pillar.Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ViewportOverlayPanelStyle" TargetType="Border">
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{DynamicResource Pillar.Brush.Background2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Pillar.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Pillar.CornerRadius.Panel}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
