<!--
    NumericUpDown.xaml
    Provides a reusable WPF numeric editor for tool settings without introducing third-party UI dependencies.
-->
<UserControl x:Class="Pillar.UI.Controls.NumericUpDown"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             MinWidth="92"
             MinHeight="24"
             Focusable="False"
             PreviewMouseWheel="NumericUpDown_PreviewMouseWheel">
    <UserControl.Resources>
        <Style x:Key="SpinnerButtonStyle"
               TargetType="{x:Type primitives:RepeatButton}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:RepeatButton}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="ValueTextBox"
                 Grid.Column="0"
                 MinHeight="24"
                 Padding="4,1"
                 VerticalContentAlignment="Center"
                 GotKeyboardFocus="ValueTextBox_GotKeyboardFocus"
                 LostKeyboardFocus="ValueTextBox_LostKeyboardFocus"
                 PreviewKeyDown="ValueTextBox_PreviewKeyDown" />

        <Grid Grid.Column="1"
              Margin="2,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <primitives:RepeatButton x:Name="IncreaseButton"
                                     Grid.Row="0"
                                     Style="{StaticResource SpinnerButtonStyle}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Delay="300"
                                     Interval="70"
                                     Click="IncreaseButton_Click"
                                     ToolTip="Increase value"
                                     AutomationProperties.Name="Increase value">
                <Path Width="7"
                      Height="4"
                      Stretch="Fill"
                      Data="M 0,4 L 3.5,0 L 7,4 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type primitives:RepeatButton}}}" />
            </primitives:RepeatButton>
            <primitives:RepeatButton x:Name="DecreaseButton"
                                     Grid.Row="1"
                                     Style="{StaticResource SpinnerButtonStyle}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Delay="300"
                                     Interval="70"
                                     Click="DecreaseButton_Click"
                                     ToolTip="Decrease value"
                                     AutomationProperties.Name="Decrease value">
                <Path Width="7"
                      Height="4"
                      Stretch="Fill"
                      Data="M 0,0 L 3.5,4 L 7,0 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type primitives:RepeatButton}}}" />
            </primitives:RepeatButton>
        </Grid>
    </Grid>
</UserControl>
