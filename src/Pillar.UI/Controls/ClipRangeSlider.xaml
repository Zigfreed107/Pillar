<!--
    ClipRangeSlider.xaml
    Provides the viewport overlay control for setting the visible Z range used by render-only clipping planes.
-->
<UserControl x:Class="Pillar.UI.Controls.ClipRangeSlider"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             MinHeight="300"
             MinWidth="96">

    <Border Style="{StaticResource ViewportOverlayPanelStyle}"
            Width="96"
            MinWidth="96"
            MaxWidth="96"
            Padding="10"
            Background="{DynamicResource Pillar.Brush.BackgroundTransparent}"
            BorderBrush="{DynamicResource Pillar.Brush.Border}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,10,0" 
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Style="{StaticResource OverlayPanelTitleTextStyle}"
                               FontFamily="Segoe Fluent Icons"
                               Text="&#xE78A;"
                               ToolBar.OverflowMode="Never">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
                <TextBlock Grid.Row="0"  Grid.Column="1"
                           HorizontalAlignment="Center"
                           Style="{StaticResource OverlayPanelTitleTextStyle}"
                           Text="Cut" />
            </Grid>
            <Canvas x:Name="SliderCanvas"
                    Grid.Row="1"
                    Width="76"
                    MinHeight="240"
                    Margin="0,16"
                    SizeChanged="SliderCanvas_SizeChanged">
                <Rectangle x:Name="SelectedModelBoundsRectangle"
                           Width="18"
                           RadiusX="2"
                           RadiusY="2"
                           Fill="{Binding SelectedModelBoundsBrush, ElementName=Root}"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />

                <Rectangle x:Name="TrackRectangle"
                           Width="8"
                           RadiusX="4"
                           RadiusY="4"
                           Fill="{StaticResource Pillar.Brush.Element1}"
                           IsHitTestVisible="False" />

                <Rectangle x:Name="VisibleRangeRectangle"
                           Width="8"
                           RadiusX="4"
                           RadiusY="4"
                           Fill="{StaticResource Pillar.Brush.AccentSubtleTransparent}"
                           IsHitTestVisible="False" />

                <Border x:Name="UpperHandle"
                        Width="54"
                        Height="14"
                        Background="{StaticResource Pillar.Brush.Element1}"
                        BorderBrush="{StaticResource Pillar.Brush.Accent}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Cursor="SizeNS"
                        MouseLeftButtonDown="UpperHandle_MouseLeftButtonDown"
                        ToolTip="Upper clipping plane" />

                <Border x:Name="LowerHandle"
                        Width="54"
                        Height="14"
                        Background="{StaticResource Pillar.Brush.Element1}"
                        BorderBrush="{StaticResource Pillar.Brush.Accent}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Cursor="SizeNS"
                        MouseLeftButtonDown="LowerHandle_MouseLeftButtonDown"
                        ToolTip="Lower clipping plane" />
            </Canvas>

            <TextBlock x:Name="RangeTextBlock"
                       Grid.Row="2"
                       HorizontalAlignment="Center"
                       FontSize="11"
                       TextAlignment="Center"
                       Style="{StaticResource OverlayPanelContentStyle}" 
                       TextWrapping="Wrap" />

            <Button Grid.Row="3"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource PillarButtonStyle}"
                    Click="ResetButton_Click"
                    Content="Reset"
                    ToolTip="Reset clipping to the full print volume" />
        </Grid>
    </Border>
</UserControl>
